{
  "name": "antinote-mcp",
  "version": "0.2.0",
  "description": "Local MCP server for reading Antinote notes and writing through supported URL actions on macOS.",
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=22.13.0" },
  "bin": { "antinote-mcp": "dist/index.js" },
  "files": ["dist", "native", "scripts", "README.md", "LICENSE"],
  "repository": { "type": "git", "url": "git+https://github.com/maferland/antinote-mcp.git" },
  "keywords": ["mcp", "antinote", "macos", "notes"],
  "scripts": {
    "build": "tsc",
    "build:reader": "node scripts/build-reader.mjs",
    "reader:grant": "node scripts/grant-reader.mjs",
    "test:native": "npm run build:reader && node --test test/native-reader.mjs",
    "start": "node dist/index.js",
    "test": "npm run build && node --test test/*.test.mjs",
    "check": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "dependencies": { "@modelcontextprotocol/sdk": "^1.32.1", "zod": "^4.6.7" },
  "devDependencies": { "@types/node": "^22.0.0", "typescript": "^5.9.0" }
}
